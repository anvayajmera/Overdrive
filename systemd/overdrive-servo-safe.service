[Unit]
Description=Overdrive Servo Safe Boot
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
User=bryanzou
WorkingDirectory=/home/bryanzou/Documents/Repos/overdrive-copy
ExecStart=/usr/bin/python3 /home/bryanzou/Documents/Repos/overdrive-copy/scripts/servo_boot_hold.py --wait-seconds 20 --repeat-seconds 10 --interval 0.1
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
